      "**/dont-touch": "deny",
      "**/dont-touch/**": "deny",
      "dont-touch": "deny",
      "dont-touch/**": "deny"
    },
    "edit": {
      "*": "allow",
      "**/dont-touch": "deny",
      "**/dont-touch/**": "deny",
      "dont-touch": "deny",
      "dont-touch/**": "deny"
    },
    "glob": {
      "*": "allow",
      "**/dont-touch": "deny",
      "**/dont-touch/**": "deny",
      "dont-touch": "deny",
      "dont-touch/**": "deny"
    },
    "grep": {
      "*": "allow",
      "**/dont-touch": "deny",
      "**/dont-touch/**": "deny",
      "dont-touch": "deny",
      "dont-touch/**": "deny"
    },
    "list": {
      "*": "allow",
      "**/dont-touch": "deny",
      "**/dont-touch/**": "deny",
      "dont-touch": "deny",
      "dont-touch/**": "deny"
    },
    "bash": {
